<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SharpSpell.Windows</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net20</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="TachyonLabs.SharpSpell.UI.SharpSpellLive.bmp" />
    <EmbeddedResource Include="TachyonLabs.SharpSpell.UI.SharpSpellLive.bmp" LogicalName="TachyonLabs.SharpSpell.UI.SharpSpellLive.bmp" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SharpSpell.Core" />
  </ItemGroup>
</Project>