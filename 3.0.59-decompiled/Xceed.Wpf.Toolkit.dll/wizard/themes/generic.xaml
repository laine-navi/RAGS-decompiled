<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters">
  <conv:WizardPageButtonVisibilityConverter x:Key="WizardPageButtonVisibilityConverter" />
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:Wizard</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="#F0F0F0" />
    <Setter Property="Control.BorderBrush" Value="#A0A0A0" />
    <Setter Property="Control.BorderThickness" Value="1" />
    <Setter Property="ItemsControl.ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:Wizard</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <Grid Panel.Background="{TemplateBinding Control.Background}">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ContentPresenter>
                <ContentPresenter.Content>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CurrentPage</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                      </RelativeSource>
                    </Binding.RelativeSource>
                  </Binding>
                </ContentPresenter.Content>
              </ContentPresenter>
              <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="0,1,0,0" Padding="7">
                <StackPanel Panel.Background="{TemplateBinding Control.Background}">
                  <Grid FrameworkElement.Margin="{TemplateBinding Control.Padding}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button FrameworkElement.Name="PART_HelpButton" Grid.Column="0" FrameworkElement.MinWidth="75" ButtonBase.Command="local:WizardCommands.Help" ContentControl.Content="{TemplateBinding local:Wizard.HelpButtonContent}">
                      <UIElement.Visibility>
                        <MultiBinding>
                          <MultiBinding.Converter>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WizardPageButtonVisibilityConverter</Ctor>
                            </StaticResourceExtension>
                          </MultiBinding.Converter>
                          <Binding Path="HelpButtonVisibility">
                            <Binding.RelativeSource>
                              <RelativeSource>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                              </RelativeSource>
                            </Binding.RelativeSource>
                          </Binding>
                          <Binding Path="CurrentPage.HelpButtonVisibility">
                            <Binding.RelativeSource>
                              <RelativeSource>
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                              </RelativeSource>
                            </Binding.RelativeSource>
                          </Binding>
                        </MultiBinding>
                      </UIElement.Visibility>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.HorizontalAlignment="Right">
                      <Button FrameworkElement.Name="PART_CancelButton" FrameworkElement.Margin="0,0,7,0" FrameworkElement.MinWidth="75" ButtonBase.Command="local:WizardCommands.Cancel" ContentControl.Content="{TemplateBinding local:Wizard.CancelButtonContent}">
                        <UIElement.Visibility>
                          <MultiBinding>
                            <MultiBinding.Converter>
                              <StaticResourceExtension xmlns="">
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WizardPageButtonVisibilityConverter</Ctor>
                              </StaticResourceExtension>
                            </MultiBinding.Converter>
                            <Binding Path="CancelButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                            <Binding Path="CurrentPage.CancelButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Button>
                      <Button FrameworkElement.Name="PART_BackButton" FrameworkElement.MinWidth="75" ButtonBase.Command="local:WizardCommands.PreviousPage" ContentControl.Content="{TemplateBinding local:Wizard.BackButtonContent}">
                        <UIElement.Visibility>
                          <MultiBinding>
                            <MultiBinding.Converter>
                              <StaticResourceExtension xmlns="">
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WizardPageButtonVisibilityConverter</Ctor>
                              </StaticResourceExtension>
                            </MultiBinding.Converter>
                            <Binding Path="BackButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                            <Binding Path="CurrentPage.BackButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Button>
                      <Button FrameworkElement.Name="PART_NextButton" FrameworkElement.MinWidth="75" ButtonBase.Command="local:WizardCommands.NextPage" ContentControl.Content="{TemplateBinding local:Wizard.NextButtonContent}">
                        <UIElement.Visibility>
                          <MultiBinding>
                            <MultiBinding.Converter>
                              <StaticResourceExtension xmlns="">
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WizardPageButtonVisibilityConverter</Ctor>
                              </StaticResourceExtension>
                            </MultiBinding.Converter>
                            <Binding Path="NextButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                            <Binding Path="CurrentPage.NextButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Button>
                      <Button FrameworkElement.Name="PART_FinishButton" FrameworkElement.Margin="7,0,0,0" FrameworkElement.MinWidth="75" ButtonBase.Command="local:WizardCommands.Finish" ContentControl.Content="{TemplateBinding local:Wizard.FinishButtonContent}">
                        <UIElement.Visibility>
                          <MultiBinding>
                            <MultiBinding.Converter>
                              <StaticResourceExtension xmlns="">
                                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WizardPageButtonVisibilityConverter</Ctor>
                              </StaticResourceExtension>
                            </MultiBinding.Converter>
                            <Binding Path="FinishButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                            <Binding Path="CurrentPage.FinishButtonVisibility">
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Button>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:Wizard</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
  <ControlTemplate x:Key="BlankWizardPageTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WizardPage</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <Border UIElement.SnapsToDevicePixels="True" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}">
      <Grid Panel.Background="{TemplateBinding Control.Background}">
        <ContentPresenter FrameworkElement.Margin="14" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" />
      </Grid>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="ExteriorWizardPageTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WizardPage</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <Grid Panel.Background="{TemplateBinding Control.Background}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border UIElement.SnapsToDevicePixels="True" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}">
        <Grid Column="0" Panel.Background="{TemplateBinding local:WizardPage.ExteriorPanelBackground}">
          <FrameworkElement.MinWidth>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ExteriorPanelMinWidth</Ctor>
              <Binding.RelativeSource>
                <RelativeSource Mode="FindAncestor" AncestorType="local:Wizard" />
              </Binding.RelativeSource>
            </Binding>
          </FrameworkElement.MinWidth>
          <ContentControl Content="{TemplateBinding local:WizardPage.ExteriorPanelContent}" />
        </Grid>
      </Border>
      <Grid Column="1" FrameworkElement.Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FrameworkElement.Margin="0,0,0,14" FontSize="16" FontWeight="Bold" Text="{TemplateBinding local:WizardPage.Title}" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FrameworkElement.Margin="0,0,0,14" Text="{TemplateBinding local:WizardPage.Description}" />
        <ContentPresenter Grid.Row="2" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" />
      </Grid>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="InteriorWizardPageTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WizardPage</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Panel.Background="{TemplateBinding local:WizardPage.HeaderBackground}" FrameworkElement.MinHeight="56">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FrameworkElement.Margin="16,9,0,1" TextWrapping="Wrap" FontWeight="Bold" Text="{TemplateBinding local:WizardPage.Title}" />
          <TextBlock FrameworkElement.Margin="32,0,0,3" TextWrapping="Wrap" Text="{TemplateBinding local:WizardPage.Description}" />
        </StackPanel>
        <Image Grid.Column="1" FrameworkElement.Margin="4" Source="{TemplateBinding local:WizardPage.HeaderImage}" Stretch="None" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="1" UIElement.SnapsToDevicePixels="True" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}">
        <Grid Panel.Background="{TemplateBinding Control.Background}">
          <ContentPresenter FrameworkElement.Margin="14" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" />
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WizardPage</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.Triggers>
      <Trigger Property="local:WizardPage.PageType" Value="Blank">
        <Setter Property="Control.Background" Value="#FFF0F0F0" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BlankWizardPageTemplate</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:WizardPage.PageType" Value="Exterior">
        <Setter Property="Control.Background" Value="#FFFFFF" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="local:WizardPage.ExteriorPanelBackground" Value="#E3EFFF" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ExteriorWizardPageTemplate</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="local:WizardPage.PageType" Value="Interior">
        <Setter Property="Control.Background" Value="#FFF0F0F0" />
        <Setter Property="Control.BorderBrush" Value="{Static SystemColors.ActiveBorderBrush}" />
        <Setter Property="Control.BorderThickness" Value="0,1,0,0" />
        <Setter Property="local:WizardPage.HeaderBackground" Value="#FFFFFF" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">InteriorWizardPageTemplate</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WizardPage</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>