<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit">
  <LinearGradientBrush x:Key="TextBoxBorder" EndPoint="0,20" GradientBrush.MappingMode="Absolute" StartPoint="0,0">
    <GradientStop Color="#ABADB3" Offset="0.05" />
    <GradientStop Color="#E2E3EA" Offset="0.07" />
    <GradientStop Color="#E3E9EF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TextBox_MouseOver" EndPoint="0,1" StartPoint="0,0">
    <GradientStop Color="#5794BF" Offset="0.05" />
    <GradientStop Color="#B7D5EA" Offset="0.07" />
    <GradientStop Color="#C7E2F1" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TextBox_Focused" EndPoint="0,1" StartPoint="0,0">
    <GradientStop Color="#3D7BAD" Offset="0.05" />
    <GradientStop Color="#A4C9E3" Offset="0.07" />
    <GradientStop Color="#B7D9ED" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="TextBox_DisabledBorder" Color="#ADB2B5" />
  <SolidColorBrush x:Key="TextBox_DisabledBackground" Color="#F4F4F4" />
  <DataTemplate x:Key="DefaultWatermarkTemplate">
    <ContentControl Control.Foreground="#FF808080" UIElement.Focusable="False">
      <ContentControl.Content>
        <Binding />
      </ContentControl.Content>
    </ContentControl>
  </DataTemplate>
  <Style x:Key="WatermarkTextBox">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WatermarkTextBox</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Foreground" Value="{DynamicResource {Static SystemColors.ControlTextBrushKey}}" />
    <Setter Property="Control.Background" Value="{DynamicResource {Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Control.BorderBrush">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBoxBorder</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.BorderThickness" Value="1" />
    <Setter Property="Control.Padding" Value="3" />
    <Setter Property="UIElement.AllowDrop" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle">
      <Setter.Value>
        <NullExtension />
      </Setter.Value>
    </Setter>
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Setter Property="local:WatermarkTextBox.WatermarkTemplate">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DefaultWatermarkTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WatermarkTextBox</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid>
            <Border Name="Border" BorderThickness="{TemplateBinding Control.BorderThickness}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="1" Background="{TemplateBinding Control.Background}" />
            <Border Name="MouseOverVisual" UIElement.Opacity="0" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="1">
              <Border.BorderBrush>
                <StaticResourceExtension xmlns="">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBox_MouseOver</Ctor>
                </StaticResourceExtension>
              </Border.BorderBrush>
            </Border>
            <Border Name="FocusVisual" UIElement.Opacity="0" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="1">
              <Border.BorderBrush>
                <StaticResourceExtension xmlns="">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBox_Focused</Ctor>
                </StaticResourceExtension>
              </Border.BorderBrush>
            </Border>
            <ScrollViewer Name="PART_ContentHost" UIElement.SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            <ContentPresenter Name="PART_WatermarkHost" Content="{TemplateBinding local:WatermarkTextBox.Watermark}" ContentTemplate="{TemplateBinding local:WatermarkTextBox.WatermarkTemplate}" FrameworkElement.VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" FrameworkElement.HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" UIElement.IsHitTestVisible="False" FrameworkElement.Margin="{TemplateBinding Control.Padding}" UIElement.Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsFocused" Value="False" />
                <Condition Property="TextBox.Text" Value="" />
              </MultiTrigger.Conditions>
              <MultiTrigger.Setters>
                <Setter TargetName="PART_WatermarkHost" Property="UIElement.Visibility" Value="Visible" />
              </MultiTrigger.Setters>
            </MultiTrigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="MouseOverVisual" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="FocusVisual" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Border.BorderBrush">
                <Setter.Value>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBox_DisabledBorder</Ctor>
                  </StaticResourceExtension>
                </Setter.Value>
              </Setter>
              <Setter TargetName="Border" Property="Border.Background">
                <Setter.Value>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextBox_DisabledBackground</Ctor>
                  </StaticResourceExtension>
                </Setter.Value>
              </Setter>
              <Setter Value="{DynamicResource {Static SystemColors.GrayTextBrushKey}}" Property="Control.Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WatermarkTextBox</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.BasedOn>
      <StaticResourceExtension xmlns="">
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WatermarkTextBox</Ctor>
      </StaticResourceExtension>
    </Style.BasedOn>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WatermarkTextBox</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>