<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit" xmlns:chrome="clr-namespace:Xceed.Wpf.Toolkit.Chromes" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters">
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <Image x:Key="DefaultContent" FrameworkElement.Height="16" FrameworkElement.Width="18" Source="./../Images/Notes16.png" />
  <LinearGradientBrush x:Key="PopupDarkBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
    <GradientStop Color="#FFA3AEB9" Offset="0" />
    <GradientStop Color="#FF8399A9" Offset="0.375" />
    <GradientStop Color="#FF718597" Offset="0.375" />
    <GradientStop Color="#FF617584" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PopupBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientBrush.GradientStops>
      <GradientStopCollection>
        <GradientStop Offset="0" Color="#FFffffff" />
        <GradientStop Offset="1" Color="#FFE8EBED" />
      </GradientStopCollection>
    </GradientBrush.GradientStops>
  </LinearGradientBrush>
  <Style x:Key="ToggleButtonStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid UIElement.SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" UIElement.SnapsToDevicePixels="True">
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" FrameworkElement.VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" FrameworkElement.HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
              </Border>
              <chrome:ButtonChrome Name="ToggleButtonChrome" Grid.Column="1" CornerRadius="0,2.75,2.75,0" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderPressed="{TemplateBinding ButtonBase.IsPressed}">
                <chrome:ButtonChrome.RenderChecked>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource Mode="FindAncestor" AncestorType="local:MultiLineTextEditor" />
                    </Binding.RelativeSource>
                  </Binding>
                </chrome:ButtonChrome.RenderChecked>
                <chrome:ButtonChrome.RenderEnabled>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsEnabled</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource Mode="FindAncestor" AncestorType="local:MultiLineTextEditor" />
                    </Binding.RelativeSource>
                  </Binding>
                </chrome:ButtonChrome.RenderEnabled>
                <Grid Name="arrowGlyph" UIElement.IsHitTestVisible="False" Column="1" FrameworkElement.Margin="5">
                  <Path Name="Arrow" FrameworkElement.Width="7" FrameworkElement.Height="4" Data="M0,1 C0,1 0,0 0,0 C0,0 3,0 3,0 C3,0 3,1 3,1 C3,1 4,1 4,1 C4,1 4,0 4,0 C4,0 7,0 7,0 C7,0 7,1 7,1 C7,1 6,1 6,1 C6,1 6,2 6,2 C6,2 5,2 5,2 C5,2 5,3 5,3 C5,3 4,3 4,3 C4,3 4,4 4,4 C4,4 3,4 3,4 C3,4 3,3 3,3 C3,3 2,3 2,3 C2,3 2,2 2,2 C2,2 1,2 1,2 C1,2 1,1 1,1 C1,1 0,1 0,1" Shape.Fill="#FF000000" />
                </Grid>
              </chrome:ButtonChrome>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="Arrow" Property="Shape.Fill" Value="#AFAFAF" />
              <Setter Property="Control.Foreground" Value="#FF808080" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:MultiLineTextEditor</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="#FFFFFFFF" />
    <Setter Property="Control.BorderBrush">
      <Setter.Value>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
          <GradientStop Color="#FFA3AEB9" Offset="0" />
          <GradientStop Color="#FF8399A9" Offset="0.375" />
          <GradientStop Color="#FF718597" Offset="0.375" />
          <GradientStop Color="#FF617584" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.BorderThickness" Value="1,1,0,1" />
    <Setter Property="ContentControl.Content">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DefaultContent</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="Control.Padding" Value="2,0,0,0" />
    <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
    <Setter Property="Control.VerticalContentAlignment" Value="Center" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:MultiLineTextEditor</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid Name="Root">
            <ToggleButton Name="PART_DropDownButton" Grid.Column="1" Control.IsTabStop="True" FrameworkElement.MinHeight="22" UIElement.SnapsToDevicePixels="True" Control.Background="{TemplateBinding Control.Background}" Control.BorderBrush="{TemplateBinding Control.BorderBrush}" Control.BorderThickness="{TemplateBinding Control.BorderThickness}" Control.Padding="{TemplateBinding Control.Padding}" ContentControl.Content="{TemplateBinding ContentControl.Content}" ContentControl.ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentControl.ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" Control.VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" Control.HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}">
              <FrameworkElement.Style>
                <StaticResourceExtension xmlns="">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButtonStyle</Ctor>
                </StaticResourceExtension>
              </FrameworkElement.Style>
              <ToggleButton.IsChecked>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                </Binding>
              </ToggleButton.IsChecked>
              <UIElement.IsHitTestVisible>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                  <Binding.Converter>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">InverseBoolConverter</Ctor>
                    </StaticResourceExtension>
                  </Binding.Converter>
                </Binding>
              </UIElement.IsHitTestVisible>
            </ToggleButton>
            <Popup StaysOpen="False" Placement="Bottom" UIElement.SnapsToDevicePixels="True" AllowsTransparency="True" UIElement.Focusable="False" PopupAnimation="Slide" FrameworkElement.Width="{TemplateBinding local:MultiLineTextEditor.DropDownWidth}" FrameworkElement.Height="{TemplateBinding local:MultiLineTextEditor.DropDownHeight}">
              <Popup.IsOpen>
                <Binding ElementName="PART_DropDownButton">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsChecked</Ctor>
                </Binding>
              </Popup.IsOpen>
              <Border BorderThickness="1">
                <Border.Background>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">PopupBackgroundBrush</Ctor>
                  </StaticResourceExtension>
                </Border.Background>
                <Border.BorderBrush>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">PopupDarkBorderBrush</Ctor>
                  </StaticResourceExtension>
                </Border.BorderBrush>
                <Grid>
                  <TextBox Name="PART_TextBox" TextBoxBase.AcceptsReturn="True" TextWrapping="{TemplateBinding local:MultiLineTextEditor.TextWrapping}" Control.Padding="{TemplateBinding Control.Padding}" TextBoxBase.VerticalScrollBarVisibility="Auto" TextBoxBase.HorizontalScrollBarVisibility="Auto" SpellCheck.IsEnabled="{TemplateBinding local:MultiLineTextEditor.IsSpellCheckEnabled}" TextBoxBase.IsReadOnly="{TemplateBinding local:MultiLineTextEditor.IsReadOnly}" TextAlignment="{TemplateBinding local:MultiLineTextEditor.TextAlignment}" FrameworkElement.Margin="3">
                    <TextBox.Text>
                      <Binding>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Text</Ctor>
                        <Binding.RelativeSource>
                          <RelativeSource>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                          </RelativeSource>
                        </Binding.RelativeSource>
                      </Binding>
                    </TextBox.Text>
                  </TextBox>
                  <Thumb Name="PART_ResizeThumb" FrameworkElement.HorizontalAlignment="Right" FrameworkElement.VerticalAlignment="Bottom" FrameworkElement.Cursor="SizeNWSE">
                    <Control.Template>
                      <ControlTemplate>
                        <ControlTemplate.TargetType>
                          <x:TypeExtension>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Thumb</Ctor>
                          </x:TypeExtension>
                        </ControlTemplate.TargetType>
                        <Grid Panel.Background="#00FFFFFF">
                          <Path Data="M0.5,6.5 L6.5,0.5 M6.5,3.5 L3.5,6.5" Shape.Stroke="#FF000000" Shape.StrokeThickness="1" />
                        </Grid>
                      </ControlTemplate>
                    </Control.Template>
                  </Thumb>
                </Grid>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:MultiLineTextEditor</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>