<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="clr-namespace:Xceed.Wpf.Toolkit.Themes" xmlns:chrome="clr-namespace:Xceed.Wpf.Toolkit.Chromes">
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">RepeatButton</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.BorderThickness" Value="1" />
    <Setter Property="Control.Padding" Value="2,2" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">RepeatButton</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid>
            <chrome:ButtonChrome Name="Chrome" Control.BorderBrush="{TemplateBinding Control.BorderBrush}" Control.Background="{TemplateBinding Control.Background}" CornerRadius="{DynamicResource {Static themes:ResourceKeys.SpinButtonCornerRadiusKey}}" RenderEnabled="{TemplateBinding UIElement.IsEnabled}" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderNormal="True" RenderPressed="{TemplateBinding ButtonBase.IsPressed}" UIElement.SnapsToDevicePixels="True" />
            <ContentPresenter FrameworkElement.HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" FrameworkElement.VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" FrameworkElement.Margin="{TemplateBinding Control.Padding}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <ComponentResourceKey ResourceId="SpinnerButtonStyleKey">
        <ComponentResourceKey.TypeInTargetAssembly>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">themes:ResourceKeys</Ctor>
          </x:TypeExtension>
        </ComponentResourceKey.TypeInTargetAssembly>
      </ComponentResourceKey>
    </x:Key>
  </Style>
</ResourceDictionary>