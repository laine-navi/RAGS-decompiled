  <ControlTemplate x:Key="ThumbControlTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Thumb</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <Border Background="#00FFFFFF" FrameworkElement.Cursor="Hand" FrameworkElement.ToolTip="Click to Drag">
      <StackPanel FrameworkElement.VerticalAlignment="Center" FrameworkElement.Width="75">
        <Line UIElement.SnapsToDevicePixels="True" Shape.Stretch="Fill" Shape.StrokeDashArray="1,2" Shape.StrokeThickness="1" X1="0" X2="1" FrameworkElement.Margin=".5">
          <Shape.Stroke>
            <SolidColorBrush Color="Gray" />
          </Shape.Stroke>
        </Line>
        <Line UIElement.SnapsToDevicePixels="True" Shape.Stretch="Fill" Shape.StrokeDashArray="1,2" Shape.StrokeThickness="1" X1="0" X2="1" FrameworkElement.Margin=".5">
