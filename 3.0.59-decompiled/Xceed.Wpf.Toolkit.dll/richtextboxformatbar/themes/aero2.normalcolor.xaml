  <ControlTemplate x:Key="richTextBoxFormatBarTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:RichTextBoxFormatBar</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <FrameworkTemplate.Resources>
      <ResourceDictionary>
        <Style>
          <Style.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Separator</Ctor>
            </x:TypeExtension>
          </Style.TargetType>
          <Style.BasedOn>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">
                <x:StaticExtension>
                  <Ctor>ToolBar.SeparatorStyleKey</Ctor>
                </x:StaticExtension>
              </Ctor>
            </StaticResourceExtension>
          </Style.BasedOn>
          <x:Key>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Separator</Ctor>
            </x:TypeExtension>
          </x:Key>
        </Style>
      </ResourceDictionary>
    </FrameworkTemplate.Resources>
    <Border CornerRadius="0" BorderThickness="1" BorderBrush="#FFADC7DE" Background="#FFDAE8F9">
      <Grid FrameworkElement.Margin="5,0,5,5">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Thumb Name="_dragWidget" FrameworkElement.Height="10">
          <Control.Template>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ThumbControlTemplate</Ctor>
            </StaticResourceExtension>
          </Control.Template>
        </Thumb>
        <StackPanel Grid.Row="1">
          <StackPanel Orientation="Horizontal">
            <ComboBox Name="_cmbFontFamilies" IsEditable="True" FrameworkElement.Width="100" FrameworkElement.ToolTip="Font Family" />
            <ComboBox Name="_cmbFontSizes" IsEditable="True" FrameworkElement.Width="43" FrameworkElement.ToolTip="Font Size" />
            <Separator />
            <ToggleButton Name="_btnBullets" ButtonBase.Command="EditingCommands.ToggleBullets" FrameworkElement.ToolTip="Bullets">
              <FrameworkElement.Style>
                <StaticResourceExtension xmlns="">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">FormatBarToggleButtonStyle</Ctor>
                </StaticResourceExtension>
              </FrameworkElement.Style>
              <ButtonBase.CommandTarget>
                <Binding Path="Target">
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
