<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit" xmlns:themes="clr-namespace:Xceed.Wpf.Toolkit.Themes" xmlns:chrome="clr-namespace:Xceed.Wpf.Toolkit.Chromes" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../Themes/Aero2/Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <DataTemplate x:Key="DefaultWatermarkTemplate">
    <ContentControl Control.Foreground="{DynamicResource {Static SystemColors.GrayTextBrushKey}}" UIElement.Focusable="False" FrameworkElement.Margin="0,0,3,0">
      <ContentControl.Content>
        <Binding />
      </ContentControl.Content>
    </ContentControl>
  </DataTemplate>
  <Style x:Key="DateTimePickerToggleButtonStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid UIElement.SnapsToDevicePixels="True">
            <chrome:ButtonChrome Name="ToggleButtonChrome" CornerRadius="0" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderPressed="{TemplateBinding ButtonBase.IsPressed}">
              <chrome:ButtonChrome.RenderChecked>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource Mode="FindAncestor" AncestorType="local:DateTimePicker" />
                  </Binding.RelativeSource>
                </Binding>
              </chrome:ButtonChrome.RenderChecked>
              <chrome:ButtonChrome.RenderEnabled>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsEnabled</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource Mode="FindAncestor" AncestorType="local:DateTimePicker" />
                  </Binding.RelativeSource>
                </Binding>
              </chrome:ButtonChrome.RenderEnabled>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch" UIElement.SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                <Grid Name="arrowGlyph" UIElement.IsHitTestVisible="False" Column="1" FrameworkElement.Margin="5">
                  <Path Name="Arrow" FrameworkElement.Width="7" FrameworkElement.Height="4" Data="M0,1 C0,1 0,0 0,0 C0,0 3,0 3,0 C3,0 3,1 3,1 C3,1 4,1 4,1 C4,1 4,0 4,0 C4,0 7,0 7,0 C7,0 7,1 7,1 C7,1 6,1 6,1 C6,1 6,2 6,2 C6,2 5,2 5,2 C5,2 5,3 5,3 C5,3 4,3 4,3 C4,3 4,4 4,4 C4,4 3,4 3,4 C3,4 3,3 3,3 C3,3 2,3 2,3 C2,3 2,2 2,2 C2,2 1,2 1,2 C1,2 1,1 1,1 C1,1 0,1 0,1" Shape.Fill="{DynamicResource {Static SystemColors.ControlTextBrushKey}}" />
                </Grid>
              </Grid>
            </chrome:ButtonChrome>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="Arrow" Value="{DynamicResource {Static SystemColors.GrayTextBrushKey}}" Property="Shape.Fill" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimePicker</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="{DynamicResource {Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Control.Foreground" Value="{DynamicResource {Static SystemColors.WindowTextBrushKey}}" />
    <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}" />
    <Setter Property="Control.BorderThickness" Value="1,1,0,1" />
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="Control.HorizontalContentAlignment" Value="Right" />
    <Setter Property="InputBase.TextAlignment" Value="Right" />
    <Setter Property="local:DateTimePicker.TimeWatermarkTemplate">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DefaultWatermarkTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="InputBase.WatermarkTemplate">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DefaultWatermarkTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimePicker</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border>
            <Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:ButtonSpinner Name="PART_Spinner" Control.IsTabStop="False" Control.Background="{TemplateBinding Control.Background}" Control.BorderThickness="{TemplateBinding Control.BorderThickness}" Control.BorderBrush="{TemplateBinding Control.BorderBrush}" AllowSpin="{TemplateBinding UpDownBase.AllowSpin}" ShowButtonSpinner="{TemplateBinding UpDownBase.ShowButtonSpinner}">
                  <local:WatermarkTextBox Name="PART_TextBox" Control.BorderThickness="0" Control.Background="#00FFFFFF" Control.FontFamily="{TemplateBinding Control.FontFamily}" Control.FontSize="{TemplateBinding Control.FontSize}" Control.FontStretch="{TemplateBinding Control.FontStretch}" Control.FontStyle="{TemplateBinding Control.FontStyle}" Control.FontWeight="{TemplateBinding Control.FontWeight}" Control.Foreground="{TemplateBinding Control.Foreground}" Control.HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" FrameworkElement.MinWidth="20" TextBoxBase.AcceptsReturn="False" Control.Padding="0" TextBox.TextAlignment="{TemplateBinding InputBase.TextAlignment}" TextBox.TextWrapping="NoWrap" Control.TabIndex="{TemplateBinding Control.TabIndex}" Watermark="{TemplateBinding InputBase.Watermark}" WatermarkTemplate="{TemplateBinding InputBase.WatermarkTemplate}">
                    <TextBoxBase.IsReadOnly>
                      <Binding>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsReadOnly</Ctor>
                        <Binding.RelativeSource>
                          <RelativeSource>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                          </RelativeSource>
                        </Binding.RelativeSource>
                      </Binding>
                    </TextBoxBase.IsReadOnly>
                    <TextBox.Text>
                      <Binding>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Text</Ctor>
                        <Binding.RelativeSource>
                          <RelativeSource>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                          </RelativeSource>
                        </Binding.RelativeSource>
                      </Binding>
                    </TextBox.Text>
                  </local:WatermarkTextBox>
                </local:ButtonSpinner>
                <ToggleButton Name="_calendarToggleButton" Grid.Column="1" Control.Background="#FFFFFFFF" UIElement.Focusable="False">
                  <FrameworkElement.Style>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DateTimePickerToggleButtonStyle</Ctor>
                    </StaticResourceExtension>
                  </FrameworkElement.Style>
                  <ToggleButton.IsChecked>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </ToggleButton.IsChecked>
                  <UIElement.IsHitTestVisible>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                      <Binding.Converter>
                        <StaticResourceExtension xmlns="">
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">InverseBoolConverter</Ctor>
                        </StaticResourceExtension>
                      </Binding.Converter>
                    </Binding>
                  </UIElement.IsHitTestVisible>
                  <UIElement.IsEnabled>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsReadOnly</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                      <Binding.Converter>
                        <StaticResourceExtension xmlns="">
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">InverseBoolConverter</Ctor>
                        </StaticResourceExtension>
                      </Binding.Converter>
                    </Binding>
                  </UIElement.IsEnabled>
                </ToggleButton>
              </Grid>
              <Popup Name="PART_Popup" StaysOpen="False">
                <Popup.IsOpen>
                  <Binding ElementName="_calendarToggleButton">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsChecked</Ctor>
                  </Binding>
                </Popup.IsOpen>
                <Border BorderThickness="1" Padding="3">
                  <Border.Background>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">PanelBackgroundBrush</Ctor>
                    </StaticResourceExtension>
                  </Border.Background>
                  <Border.BorderBrush>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">PopupDarkBorderBrush</Ctor>
                    </StaticResourceExtension>
                  </Border.BorderBrush>
                  <StackPanel>
                    <Calendar Name="PART_Calendar" Control.BorderThickness="0" />
                    <local:TimePicker Name="PART_TimeUpDown" Control.Background="{DynamicResource {Static SystemColors.WindowBrushKey}}" Control.Foreground="{DynamicResource {Static SystemColors.WindowTextBrushKey}}" Format="{TemplateBinding local:DateTimePicker.TimeFormat}" FormatString="{TemplateBinding local:DateTimePicker.TimeFormatString}" Watermark="{TemplateBinding local:DateTimePicker.TimeWatermark}" WatermarkTemplate="{TemplateBinding local:DateTimePicker.TimeWatermarkTemplate}">
                      <local:TimePicker.Value>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Value</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </local:TimePicker.Value>
                      <local:TimePicker.Minimum>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Minimum</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </local:TimePicker.Minimum>
                      <local:TimePicker.Maximum>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Maximum</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </local:TimePicker.Maximum>
                      <local:TimePicker.ClipValueToMinMax>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ClipValueToMinMax</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </local:TimePicker.ClipValueToMinMax>
                    </local:TimePicker>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlMouseOverBorderKey}}" Property="Control.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlSelectedBorderKey}}" Property="Control.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {Static SystemColors.GrayTextBrushKey}}" Property="Control.Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="PART_TextBox" Property="FocusManager.FocusedElement">
                <Setter.Value>
                  <Binding ElementName="PART_TextBox" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimePicker</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>