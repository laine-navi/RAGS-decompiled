<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:Xceed.Wpf.Toolkit.Primitives">
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">primitives:SelectorItem</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="{DynamicResource {Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Control.IsTabStop" Value="False" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">primitives:SelectorItem</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Name="_background" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <CheckBox Control.Foreground="{TemplateBinding Control.Foreground}" ContentControl.Content="{TemplateBinding ContentControl.Content}" ContentControl.ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" ContentControl.ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}">
              <ToggleButton.IsChecked>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsSelected</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                </Binding>
              </ToggleButton.IsChecked>
            </CheckBox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="_background" Value="{DynamicResource {Static SystemColors.HighlightBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {Static SystemColors.HighlightTextBrushKey}}" Property="Control.Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="_background" Value="{DynamicResource {Static SystemColors.HighlightBrushKey}}" Property="Border.Background" />
              <Setter Value="{DynamicResource {Static SystemColors.HighlightTextBrushKey}}" Property="Control.Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">primitives:SelectorItem</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>