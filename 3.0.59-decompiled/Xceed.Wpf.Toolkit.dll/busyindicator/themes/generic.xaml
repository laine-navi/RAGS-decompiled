<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit">
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:BusyIndicator</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="local:BusyIndicator.BusyContent" Value="Please wait..." />
    <Setter Property="Control.IsTabStop" Value="False" />
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="local:BusyIndicator.OverlayStyle">
      <Setter.Value>
        <Style>
          <Style.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Rectangle</Ctor>
            </x:TypeExtension>
          </Style.TargetType>
          <Setter Property="Shape.Fill" Value="#FFFFFFFF" />
          <Setter Property="UIElement.Opacity" Value="0.5" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="local:BusyIndicator.ProgressBarStyle">
      <Setter.Value>
        <Style>
          <Style.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ProgressBar</Ctor>
            </x:TypeExtension>
          </Style.TargetType>
          <Setter Property="ProgressBar.IsIndeterminate" Value="True" />
          <Setter Property="FrameworkElement.Height" Value="15" />
          <Setter Property="FrameworkElement.Margin" Value="8,0,8,8" />
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="local:BusyIndicator.DisplayAfter" Value="00:00:00.1" />
    <Setter Property="FrameworkElement.HorizontalAlignment" Value="Stretch" />
    <Setter Property="FrameworkElement.VerticalAlignment" Value="Stretch" />
    <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:BusyIndicator</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="VisibilityStates">
                <VisualState x:Name="Hidden">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Timeline.BeginTime="00:00:00" Timeline.Duration="00:00:00.001" Storyboard.TargetName="busycontent" Storyboard.TargetProperty="(UIElement.Visibility)">
                      <DiscreteObjectKeyFrame ObjectKeyFrame.KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <Visibility>Collapsed</Visibility>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Timeline.BeginTime="00:00:00" Timeline.Duration="00:00:00.001" Storyboard.TargetName="overlay" Storyboard.TargetProperty="(UIElement.Visibility)">
                      <DiscreteObjectKeyFrame ObjectKeyFrame.KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <Visibility>Collapsed</Visibility>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Visible">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Timeline.BeginTime="00:00:00" Timeline.Duration="00:00:00.001" Storyboard.TargetName="busycontent" Storyboard.TargetProperty="(UIElement.Visibility)">
                      <DiscreteObjectKeyFrame ObjectKeyFrame.KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <Visibility>Visible</Visibility>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Timeline.BeginTime="00:00:00" Timeline.Duration="00:00:00.001" Storyboard.TargetName="overlay" Storyboard.TargetProperty="(UIElement.Visibility)">
                      <DiscreteObjectKeyFrame ObjectKeyFrame.KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <Visibility>Visible</Visibility>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="BusyStatusStates">
                <VisualState x:Name="Idle">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Timeline.BeginTime="00:00:00" Timeline.Duration="00:00:00.001" Storyboard.TargetName="content" Storyboard.TargetProperty="(Control.IsEnabled)">
                      <DiscreteObjectKeyFrame ObjectKeyFrame.KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <system:Boolean xmlns:system="clr-namespace:System;assembly=System.Private.CoreLib">True</system:Boolean>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Busy">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Timeline.BeginTime="00:00:00" Timeline.Duration="00:00:00.001" Storyboard.TargetName="content" Storyboard.TargetProperty="(Control.IsEnabled)">
                      <DiscreteObjectKeyFrame ObjectKeyFrame.KeyTime="00:00:00">
                        <ObjectKeyFrame.Value>
                          <Boolean xmlns="clr-namespace:System;assembly=System.Private.CoreLib">False</Boolean>
                        </ObjectKeyFrame.Value>
                      </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentControl Name="content" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Control.HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Control.VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" Control.IsTabStop="False" UIElement.Focusable="False" />
            <Rectangle Name="overlay" FrameworkElement.Style="{TemplateBinding local:BusyIndicator.OverlayStyle}" />
            <ContentPresenter Name="busycontent">
              <ContentPresenter.Content>
                <Grid FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center">
                  <Border Background="#FFFFFFFF" BorderThickness="1" CornerRadius="2">
                    <Border.BorderBrush>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFA3AEB9" Offset="0" />
                        <GradientStop Color="#FF8399A9" Offset="0.375" />
                        <GradientStop Color="#FF718597" Offset="0.375" />
                        <GradientStop Color="#FF617584" Offset="1" />
                      </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border CornerRadius="1.5" FrameworkElement.Margin="1">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                          <GradientStop Color="#FFF6F8F9" Offset="0.02" />
                          <GradientStop Color="#FFB8B8B8" Offset="0.996" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Grid FrameworkElement.MinWidth="150">
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Content="{TemplateBinding local:BusyIndicator.BusyContent}" ContentTemplate="{TemplateBinding local:BusyIndicator.BusyContentTemplate}" FrameworkElement.Margin="8" />
                        <ProgressBar Grid.Row="1" FrameworkElement.Style="{TemplateBinding local:BusyIndicator.ProgressBarStyle}" />
                      </Grid>
                    </Border>
                  </Border>
                </Grid>
              </ContentPresenter.Content>
            </ContentPresenter>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:BusyIndicator</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>