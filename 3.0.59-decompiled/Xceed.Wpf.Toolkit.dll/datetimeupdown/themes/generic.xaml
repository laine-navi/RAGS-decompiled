<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="clr-namespace:Xceed.Wpf.Toolkit.Themes" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit">
  <DataTemplate x:Key="DefaultWatermarkTemplate">
    <ContentControl Control.Foreground="#FF808080" UIElement.Focusable="False" FrameworkElement.Margin="0,0,3,0">
      <ContentControl.Content>
        <Binding />
      </ContentControl.Content>
    </ContentControl>
  </DataTemplate>
  <Style x:Key="DateTimeUpDown">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimeUpDown</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="{DynamicResource {Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}" />
    <Setter Property="Control.BorderThickness" Value="1" />
    <Setter Property="Control.Foreground" Value="{DynamicResource {Static SystemColors.WindowTextBrushKey}}" />
    <Setter Property="Control.HorizontalContentAlignment" Value="Right" />
    <Setter Property="InputBase.TextAlignment" Value="Right" />
    <Setter Property="InputBase.WatermarkTemplate">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DefaultWatermarkTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.IsTabStop" Value="False" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimeUpDown</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <local:ButtonSpinner Name="PART_Spinner" Control.IsTabStop="False" Control.Background="{TemplateBinding Control.Background}" Control.BorderBrush="{TemplateBinding Control.BorderBrush}" Control.BorderThickness="{TemplateBinding Control.BorderThickness}" AllowSpin="{TemplateBinding UpDownBase.AllowSpin}" ShowButtonSpinner="{TemplateBinding UpDownBase.ShowButtonSpinner}">
            <local:WatermarkTextBox Name="PART_TextBox" Control.BorderThickness="0" Control.Background="#00FFFFFF" FrameworkElement.ContextMenu="{TemplateBinding FrameworkElement.ContextMenu}" Control.FontFamily="{TemplateBinding Control.FontFamily}" Control.FontSize="{TemplateBinding Control.FontSize}" Control.FontStretch="{TemplateBinding Control.FontStretch}" Control.FontStyle="{TemplateBinding Control.FontStyle}" Control.FontWeight="{TemplateBinding Control.FontWeight}" Control.Foreground="{TemplateBinding Control.Foreground}" Control.HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" FrameworkElement.MinWidth="20" TextBoxBase.AcceptsReturn="False" Control.Padding="{TemplateBinding Control.Padding}" TextBox.TextAlignment="{TemplateBinding InputBase.TextAlignment}" TextBox.TextWrapping="NoWrap" Control.TabIndex="{TemplateBinding Control.TabIndex}" Watermark="{TemplateBinding InputBase.Watermark}" WatermarkTemplate="{TemplateBinding InputBase.WatermarkTemplate}">
              <TextBoxBase.IsReadOnly>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsReadOnly</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                </Binding>
              </TextBoxBase.IsReadOnly>
              <TextBox.Text>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Text</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                </Binding>
              </TextBox.Text>
            </local:WatermarkTextBox>
          </local:ButtonSpinner>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="PART_TextBox" Property="FocusManager.FocusedElement">
                <Setter.Value>
                  <Binding ElementName="PART_TextBox" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimeUpDown</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.BasedOn>
      <StaticResourceExtension xmlns="">
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DateTimeUpDown</Ctor>
      </StaticResourceExtension>
    </Style.BasedOn>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:DateTimeUpDown</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>