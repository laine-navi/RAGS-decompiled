<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WPFRagsLib.InsertVariableWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Window.Title="Insert Variable" FrameworkElement.Height="500" FrameworkElement.Width="450" Window.Icon="App.ico" Window.WindowStartupLocation="CenterOwner" xmlns:wpfragslib="clr-namespace:WPFRagsLib;assembly=WPFRagsLib">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#66FB9400" Offset="0" />
        <GradientStop Color="#66E7F745" Offset="1" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="25" />
      <RowDefinition />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Label Grid.ColumnSpan="2" ContentControl.Content="Select Variable Name To Insert:" />
    <TabControl Name="theTabControl" Grid.ColumnSpan="2" Grid.Row="1" Control.Background="#00FFFFFF">
      <TabItem HeaderedContentControl.Header="System Variables">
        <Control.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFB9400" Offset="0" />
            <GradientStop Color="#FFE7F745" Offset="1" />
          </LinearGradientBrush>
        </Control.Background>
        <ListBox Name="lbSysVariables" Control.Background="#00FFFFFF">
          <ListBoxItem ContentControl.Content="[playername]" />
          <ListBoxItem ContentControl.Content="[inputdata]" />
          <ListBoxItem ContentControl.Content="[maxcarry]" />
          <ListBoxItem ContentControl.Content="[currentcarry]" />
          <ListBoxItem ContentControl.Content="[turns]" />
          <ListBoxItem ContentControl.Content="[man/woman]" />
          <ListBoxItem ContentControl.Content="[male/female]" />
          <ListBoxItem ContentControl.Content="[boy/girl]" />
          <ListBoxItem ContentControl.Content="[len(&lt;variablename&gt;)]" />
          <ListBoxItem ContentControl.Content="[collen(&lt;variablename&gt;)]" />
          <ListBoxItem ContentControl.Content="[a/an]" />
          <ListBoxItem ContentControl.Content="[char.name]" />
          <ListBoxItem ContentControl.Content="[item.name]" />
          <ListBoxItem ContentControl.Content="[item.id]" />
          <ListBoxItem ContentControl.Content="[room.name]" />
          <ListBoxItem ContentControl.Content="[room.id]" />
          <ListBoxItem ContentControl.Content="[exit.active]" />
          <ListBoxItem ContentControl.Content="[exit.direction]" />
          <ListBoxItem ContentControl.Content="[exit.destname]" />
          <ListBoxItem ContentControl.Content="[exit.destid]" />
          <!--Unknown connection ID: 2-->
        </ListBox>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Variables">
        <Control.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFB9400" Offset="0" />
            <GradientStop Color="#FFE7F745" Offset="1" />
          </LinearGradientBrush>
        </Control.Background>
        <ListBox Name="lbVariables" Control.Background="#00FFFFFF">
          <!--Unknown connection ID: 3-->
        </ListBox>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Custom Properties">
        <Control.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFB9400" Offset="0" />
            <GradientStop Color="#FFE7F745" Offset="1" />
          </LinearGradientBrush>
        </Control.Background>
        <ListBox Name="lbCustProp" Control.Background="#00FFFFFF">
          <!--Unknown connection ID: 4-->
        </ListBox>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Objects">
        <Control.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFFB9400" Offset="0" />
            <GradientStop Color="#FFE7F745" Offset="1" />
          </LinearGradientBrush>
        </Control.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="30" />
            <RowDefinition Height="25" />
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="30" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label ContentControl.Content="Object Type:" />
          <Label Grid.Column="1" ContentControl.Content="Object Name:" />
          <Label Grid.Column="2" ContentControl.Content="Attribute:" />
          <ComboBox Name="cbObjectType" FrameworkElement.VerticalAlignment="Center" Grid.Row="1" FrameworkElement.Margin="2,0">
            <ComboBoxItem ContentControl.Content="CA" />
            <ComboBoxItem ContentControl.Content="IA" />
            <ComboBoxItem ContentControl.Content="PA" />
            <ComboBoxItem ContentControl.Content="RA" />
            <ComboBoxItem ContentControl.Content="TA" />
            <!--Unknown connection ID: 5-->
          </ComboBox>
          <ComboBox Name="cbObject" FrameworkElement.VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" FrameworkElement.Margin="2,0">
            <!--Unknown connection ID: 6-->
          </ComboBox>
          <ComboBox Name="cbAttribute" FrameworkElement.VerticalAlignment="Center" Grid.Column="2" Grid.Row="1" FrameworkElement.Margin="2,0">
            <!--Unknown connection ID: 7-->
          </ComboBox>
          <Label Grid.Row="2" ContentControl.Content="Action Name:" />
          <Label Grid.Column="2" Grid.Row="2" ContentControl.Content="Secondary Attribute:" />
          <ComboBox Name="cbActionName" Grid.ColumnSpan="2" FrameworkElement.VerticalAlignment="Center" Grid.Row="3" FrameworkElement.Margin="2,0">
            <!--Unknown connection ID: 8-->
          </ComboBox>
          <ComboBox Name="cbSecondaryAttribute" FrameworkElement.VerticalAlignment="Center" Grid.Column="2" Grid.Row="3" FrameworkElement.Margin="2,0">
            <!--Unknown connection ID: 9-->
          </ComboBox>
          <Label Grid.Column="0" Grid.Row="4" ContentControl.Content="Text To Insert:" FrameworkElement.VerticalAlignment="Bottom" />
          <TextBox Name="tbText" Grid.Row="5" Grid.ColumnSpan="3" FrameworkElement.VerticalAlignment="Center">
            <!--Unknown connection ID: 10-->
          </TextBox>
        </Grid>
      </TabItem>
      <!--Unknown connection ID: 1-->
    </TabControl>
    <Button Grid.Row="2" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Center" ContentControl.Content="Insert">
      <!--Unknown connection ID: 11-->
    </Button>
    <Button Grid.Row="2" Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Center" ContentControl.Content="Cancel">
      <!--Unknown connection ID: 12-->
    </Button>
  </Grid>
</Window>