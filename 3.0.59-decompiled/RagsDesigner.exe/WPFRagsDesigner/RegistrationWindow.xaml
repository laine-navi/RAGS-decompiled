<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WPFRagsDesigner.RegistrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Window.Title="Registration" FrameworkElement.Height="300" FrameworkElement.Width="300" Window.Icon="App.ico" Window.WindowStartupLocation="CenterOwner" xmlns:wpfragsdesigner="clr-namespace:WPFRagsDesigner;assembly=RagsDesigner">
