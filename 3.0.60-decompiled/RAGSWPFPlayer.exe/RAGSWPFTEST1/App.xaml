<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="RAGSWPFTEST1.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Application.ShutdownMode="OnMainWindowClose" xmlns:ragswpftest1="clr-namespace:RAGSWPFTEST1;assembly=RAGSWPFPlayer" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Style x:Key="alternatingListViewItemStyle">
        <Style.TargetType>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListViewItem</Ctor>
          </x:TypeExtension>
        </Style.TargetType>
        <Setter Property="FrameworkElement.MaxHeight" Value="100" />
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Control.Background" Value="#FFD3D3D3" />
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Control.Background" Value="#FFFFFFFF" />
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="True">
            <Setter Property="Control.Background" Value="#66008000" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style>
        <Style.TargetType>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DatePickerTextBox</Ctor>
          </x:TypeExtension>
        </Style.TargetType>
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <TextBox Name="PART_TextBox">
                <TextBox.Text>
                  <Binding Path="SelectedDate" BindingBase.StringFormat="MM dd yyyy hh:mm:ss">
                    <Binding.RelativeSource>
                      <RelativeSource>
                        <RelativeSource.AncestorType>
                          <x:TypeExtension>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DatePicker</Ctor>
                          </x:TypeExtension>
                        </RelativeSource.AncestorType>
                      </RelativeSource>
                    </Binding.RelativeSource>
                  </Binding>
                </TextBox.Text>
              </TextBox>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <x:Key>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DatePickerTextBox</Ctor>
          </x:TypeExtension>
        </x:Key>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>