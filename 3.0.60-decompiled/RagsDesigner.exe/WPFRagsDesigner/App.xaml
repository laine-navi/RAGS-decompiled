<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="WPFRagsDesigner.App" xmlns:WPFRagsLib="clr-namespace:WPFRagsLib;assembly=WPFRagsLib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wpfragsdesigner="clr-namespace:WPFRagsDesigner;assembly=RagsDesigner" StartupUri="RagsDesigner.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Style x:Key="alternatingListViewItemStyle">
        <Style.TargetType>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListViewItem</Ctor>
          </x:TypeExtension>
        </Style.TargetType>
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Control.Background" Value="#FFD3D3D3" />
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Control.Background" Value="#FFFFFFFF" />
          </Trigger>
          <Trigger Property="ListBoxItem.IsSelected" Value="True">
            <Setter Property="Control.Background" Value="#66008000" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="alternateTreeViewItemStyle">
        <Style.TargetType>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TreeViewItem</Ctor>
          </x:TypeExtension>
        </Style.TargetType>
        <Style.Triggers>
          <Trigger Property="TreeViewItem.IsSelected" Value="True">
            <Setter Property="Control.BorderBrush" Value="#FF000000" />
            <Setter Property="Control.BorderThickness" Value="2" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>