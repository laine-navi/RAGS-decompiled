<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit" xmlns:themes="clr-namespace:Xceed.Wpf.Toolkit.Themes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../Themes/Aero2/Glyphs.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ButtonSpinner</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="{DynamicResource {Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Control.Foreground" Value="{DynamicResource {Static SystemColors.WindowTextBrushKey}}" />
    <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}" />
    <Setter Property="Control.BorderThickness" Value="1" />
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Control.IsTabStop" Value="True" />
    <Setter Property="Control.Padding" Value="1" />
    <Setter Property="Control.VerticalContentAlignment" Value="Center" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ButtonSpinner</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Name="Border" UIElement.SnapsToDevicePixels="True" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter UIElement.Focusable="False" FrameworkElement.Margin="{TemplateBinding Control.Padding}" FrameworkElement.HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" UIElement.SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" FrameworkElement.VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
              <Grid Column="1" FrameworkElement.Width="{DynamicResource {Static SystemParameters.VerticalScrollBarWidthKey}}">
                <UIElement.Visibility>
                  <TemplateBindingExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowButtonSpinner</Ctor>
                    <TemplateBindingExtension.Converter>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BooleanToVisibilityConverter</Ctor>
                      </StaticResourceExtension>
                    </TemplateBindingExtension.Converter>
                  </TemplateBindingExtension>
                </UIElement.Visibility>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <RepeatButton Name="PART_IncreaseButton" FrameworkElement.Style="{DynamicResource {Static themes:ResourceKeys.SpinnerButtonStyleKey}}" Control.IsTabStop="{TemplateBinding Control.IsTabStop}">
                  <ContentControl.ContentTemplate>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IncreaseGlyphNormalKey</Ctor>
                    </StaticResourceExtension>
                  </ContentControl.ContentTemplate>
                </RepeatButton>
                <RepeatButton Name="PART_DecreaseButton" Grid.Row="1" FrameworkElement.Style="{DynamicResource {Static themes:ResourceKeys.SpinnerButtonStyleKey}}" Control.IsTabStop="{TemplateBinding Control.IsTabStop}">
                  <ContentControl.ContentTemplate>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DecreaseGlyphNormalKey</Ctor>
                    </StaticResourceExtension>
                  </ContentControl.ContentTemplate>
                </RepeatButton>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlMouseOverBorderKey}}" Property="Control.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlSelectedBorderKey}}" Property="Control.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlDisabledBackgroundKey}}" Property="Control.Background" />
            </Trigger>
            <Trigger SourceName="PART_IncreaseButton" Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="PART_IncreaseButton" Property="ContentControl.ContentTemplate">
                <Setter.Value>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IncreaseGlyphDisabledKey</Ctor>
                  </StaticResourceExtension>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger SourceName="PART_DecreaseButton" Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="PART_DecreaseButton" Property="ContentControl.ContentTemplate">
                <Setter.Value>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">DecreaseGlyphDisabledKey</Ctor>
                  </StaticResourceExtension>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ButtonSpinner</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>