<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:media="clr-namespace:Xceed.Wpf.Toolkit.Core.Media" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters" xmlns:primitives="clr-namespace:Xceed.Wpf.Toolkit.Primitives">
  <ImageBrush x:Key="resize_grip" ImageSource="Images/resize_grip.png" />
  <Style x:Key="buttonImageStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Image</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Image.Stretch" Value="None" />
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
    <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
  </Style>
  <BitmapImage x:Key="minimize_normal" UriSource="Images/minimize_normal.png" />
  <BitmapImage x:Key="minimize_hover" UriSource="Images/minimize_hover.png" />
  <BitmapImage x:Key="minimize_pressed" UriSource="Images/minimize_pressed.png" />
  <BitmapImage x:Key="minimize_inactive" UriSource="Images/minimize_inactive.png" />
  <BitmapImage x:Key="maximize_normal" UriSource="Images/maximize_normal.png" />
  <BitmapImage x:Key="maximize_hover" UriSource="Images/maximize_hover.png" />
  <BitmapImage x:Key="maximize_pressed" UriSource="Images/maximize_pressed.png" />
  <BitmapImage x:Key="maximize_inactive" UriSource="Images/maximize_inactive.png" />
  <BitmapImage x:Key="maximize_disabled" UriSource="Images/maximize_disabled.png" />
  <BitmapImage x:Key="restore_normal" UriSource="Images/restore_normal.png" />
  <BitmapImage x:Key="restore_hover" UriSource="Images/restore_hover.png" />
  <BitmapImage x:Key="restore_pressed" UriSource="Images/restore_pressed.png" />
  <BitmapImage x:Key="restore_inactive" UriSource="Images/restore_inactive.png" />
  <BitmapImage x:Key="restore_disabled" UriSource="Images/restore_disabled.png" />
  <BitmapImage x:Key="close_normal" UriSource="Images/close_normal.png" />
  <BitmapImage x:Key="close_hover" UriSource="Images/close_hover.png" />
  <BitmapImage x:Key="close_pressed" UriSource="Images/close_pressed.png" />
  <BitmapImage x:Key="close_inactive" UriSource="Images/close_inactive.png" />
  <BitmapImage x:Key="close_rounded_normal" UriSource="Images/close_rounded_normal.png" />
  <BitmapImage x:Key="close_rounded_hover" UriSource="Images/close_rounded_hover.png" />
  <BitmapImage x:Key="close_rounded_pressed" UriSource="Images/close_rounded_pressed.png" />
  <BitmapImage x:Key="close_rounded_inactive" UriSource="Images/close_rounded_inactive.png" />
  <BitmapImage x:Key="close_toolwindow_normal" UriSource="Images/close_toolwindow_normal.png" />
  <BitmapImage x:Key="close_toolwindow_hover" UriSource="Images/close_toolwindow_hover.png" />
  <BitmapImage x:Key="close_toolwindow_pressed" UriSource="Images/close_toolwindow_pressed.png" />
  <BitmapImage x:Key="close_toolwindow_inactive" UriSource="Images/close_toolwindow_inactive.png" />
  <ControlTemplate x:Key="buttonTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <Border FrameworkElement.Name="outerBorder" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
      <Image Source="{TemplateBinding ContentControl.Content}">
        <FrameworkElement.Style>
          <StaticResourceExtension xmlns="">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">buttonImageStyle</Ctor>
          </StaticResourceExtension>
        </FrameworkElement.Style>
      </Image>
    </Border>
  </ControlTemplate>
  <Style x:Key="windowButtonBaseStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.IsTabStop" Value="False" />
    <Setter Property="FrameworkElement.Margin" Value="0,-1,0,0" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">buttonTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.BasedOn>
      <StaticResourceExtension xmlns="">
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">windowButtonBaseStyle</Ctor>
      </StaticResourceExtension>
    </Style.BasedOn>
    <Setter Property="FrameworkElement.ToolTip" Value="Close" />
    <Setter Property="ContentControl.Content">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_normal</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="False">
        <DataTrigger.Binding>
          <Binding Path="IsActive">
            <Binding.RelativeSource>
              <RelativeSource>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
              </RelativeSource>
            </Binding.RelativeSource>
          </Binding>
        </DataTrigger.Binding>
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_inactive</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </DataTrigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_hover</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_pressed</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="FrameworkElement.Name" Value="PART_ToolWindowCloseButton">
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_toolwindow_normal</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="PART_ToolWindowCloseButton">
            <Condition.Binding>
              <Binding Path="Name">
                <Binding.RelativeSource>
                  <RelativeSource>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">self</Ctor>
                  </RelativeSource>
                </Binding.RelativeSource>
              </Binding>
            </Condition.Binding>
          </Condition>
          <Condition Value="False">
            <Condition.Binding>
              <Binding Path="IsActive">
                <Binding.RelativeSource>
                  <RelativeSource>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                  </RelativeSource>
                </Binding.RelativeSource>
              </Binding>
            </Condition.Binding>
          </Condition>
        </MultiDataTrigger.Conditions>
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_toolwindow_inactive</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </MultiDataTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="FrameworkElement.Name" Value="PART_ToolWindowCloseButton" />
          <Condition Property="UIElement.IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_toolwindow_hover</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="FrameworkElement.Name" Value="PART_ToolWindowCloseButton" />
          <Condition Property="ButtonBase.IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="ContentControl.Content">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">close_toolwindow_pressed</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </MultiTrigger>
    </Style.Triggers>
    <x:Key>
      <ComponentResourceKey ResourceId="DefaultCloseButtonStyle">
        <ComponentResourceKey.TypeInTargetAssembly>
          <x:TypeExtension>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">primitives:WindowControl</Ctor>
          </x:TypeExtension>
        </ComponentResourceKey.TypeInTargetAssembly>
      </ComponentResourceKey>
    </x:Key>
  </Style>
  <SolidColorBrush x:Key="Window_WindowBorderBrush" Color="#FF252C33" />
  <conv:ColorBlendConverter x:Key="Window_WindowBackground_converter" BlendedColor="#FFA0A0A0" BlendedColorRatio="0.35" />
  <SolidColorBrush x:Key="Window_WindowBackground" Brush.Opacity="0.85">
    <SolidColorBrush.Color>
      <Binding Source="{Static media:WindowColors.ColorizationColor}">
        <Binding.Converter>
          <StaticResourceExtension xmlns="">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_WindowBackground_converter</Ctor>
          </StaticResourceExtension>
        </Binding.Converter>
      </Binding>
    </SolidColorBrush.Color>
  </SolidColorBrush>
  <SolidColorBrush x:Key="Window_Background" Color="White" />
  <conv:ColorBlendConverter x:Key="Window_WindowInactiveBackground_converter" BlendedColor="#FFF0F0F0" BlendedColorRatio="0.67" />
  <SolidColorBrush x:Key="Window_WindowInactiveBackground" Brush.Opacity="0.85">
    <SolidColorBrush.Color>
      <Binding Source="{Static media:WindowColors.ColorizationColor}">
        <Binding.Converter>
          <StaticResourceExtension xmlns="">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_WindowInactiveBackground_converter</Ctor>
          </StaticResourceExtension>
        </Binding.Converter>
      </Binding>
    </SolidColorBrush.Color>
  </SolidColorBrush>
  <SolidColorBrush x:Key="Window_CaptionForeground" Color="Black" />
  <Thickness x:Key="Window_WindowBorderThickness">1</Thickness>
  <DrawingBrush x:Key="CheckerBrush" TileBrush.Viewport="0,0,10,10" TileBrush.ViewportUnits="Absolute" TileBrush.TileMode="Tile">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFFFFF">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0 100,100" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFD3D3D3">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="0,0 50,50" />
              <RectangleGeometry Rect="50,50 50,50" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>