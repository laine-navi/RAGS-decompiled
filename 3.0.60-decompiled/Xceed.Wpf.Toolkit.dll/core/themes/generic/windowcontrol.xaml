<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit.Primitives" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters" xmlns:core="clr-namespace:Xceed.Wpf.Toolkit.Core" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../../Themes/Generic/Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <system:Double x:Key="TopBorderThumbHeight" xmlns:system="clr-namespace:System;assembly=System.Private.CoreLib">8</system:Double>
  <conv:WindowContentBorderMarginConverter x:Key="WindowContentBorderMarginConverter" />
  <conv:WindowControlBackgroundConverter x:Key="WindowControlBackgroundConverter" />
  <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
  <conv:CenterTitleConverter x:Key="CenterTitleConverter" />
  <ControlTemplate x:Key="WindowControlTemplate">
    <ControlTemplate.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WindowControl</Ctor>
      </x:TypeExtension>
    </ControlTemplate.TargetType>
    <Grid>
      <Border Name="PART_WindowRoot" BorderThickness="{TemplateBinding local:WindowControl.WindowBorderThickness}" BorderBrush="{TemplateBinding local:WindowControl.WindowBorderBrush}" CornerRadius="6" FrameworkElement.Width="{TemplateBinding FrameworkElement.Width}" FrameworkElement.Height="{TemplateBinding FrameworkElement.Height}">
        <Border.Background>
          <MultiBinding>
            <MultiBinding.Converter>
              <StaticResourceExtension xmlns="">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowControlBackgroundConverter</Ctor>
              </StaticResourceExtension>
            </MultiBinding.Converter>
            <Binding Path="WindowBackground">
              <Binding.RelativeSource>
                <RelativeSource>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                </RelativeSource>
              </Binding.RelativeSource>
            </Binding>
            <Binding Path="WindowOpacity">
              <Binding.RelativeSource>
                <RelativeSource>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                </RelativeSource>
              </Binding.RelativeSource>
            </Binding>
          </MultiBinding>
        </Border.Background>
        <Border Name="WindowRootInnerBorder" BorderThickness="1" BorderBrush="#FFFFFFFF" CornerRadius="6">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Name="PART_HeaderGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition>
                  <ColumnDefinition.Width>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowThickness.Left</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Name="HeaderButtonsColumn" Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Name="HeaderRow" Height="22" />
                <RowDefinition>
                  <RowDefinition.Height>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowThickness.Top</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </RowDefinition.Height>
                </RowDefinition>
              </Grid.RowDefinitions>
              <Image Name="PART_Icon" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" FrameworkElement.VerticalAlignment="Center" Source="{TemplateBinding local:WindowControl.CaptionIcon}" FrameworkElement.MaxWidth="15" FrameworkElement.MaxHeight="15" FrameworkElement.Margin="0,2,0,2" />
              <Grid Name="Title" Column="2" Row="0" RowSpan="2">
                <Rectangle Shape.Fill="{TemplateBinding local:WindowControl.CaptionShadowBrush}">
                  <FrameworkElement.Width>
                    <Binding ElementName="TitleGrid" Path="ActualWidth" />
                  </FrameworkElement.Width>
                  <FrameworkElement.Height>
                    <Binding ElementName="TitleGrid" Path="ActualHeight" />
                  </FrameworkElement.Height>
                  <FrameworkElement.HorizontalAlignment>
                    <Binding ElementName="TitleGrid" Path="HorizontalAlignment" />
                  </FrameworkElement.HorizontalAlignment>
                  <FrameworkElement.VerticalAlignment>
                    <Binding ElementName="TitleGrid" Path="VerticalAlignment" />
                  </FrameworkElement.VerticalAlignment>
                  <UIElement.Effect>
                    <BlurEffect Radius="10" />
                  </UIElement.Effect>
                </Rectangle>
                <Grid Name="TitleGrid" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Center">
                  <TextBlock Name="TitleText" Text="{TemplateBinding local:WindowControl.Caption}" Foreground="{TemplateBinding local:WindowControl.CaptionForeground}" TextTrimming="CharacterEllipsis" FrameworkElement.Margin="5,0,5,0" />
                </Grid>
              </Grid>
              <StackPanel Name="ButtonsPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Orientation="Horizontal" FrameworkElement.VerticalAlignment="Top" FrameworkElement.HorizontalAlignment="Right">
                <FrameworkElement.Margin>
                  <MultiBinding ConverterParameter="2">
                    <MultiBinding.Converter>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowContentBorderMarginConverter</Ctor>
                      </StaticResourceExtension>
                    </MultiBinding.Converter>
                    <Binding Path="WindowThickness.Right">
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                    <Binding Path="WindowThickness.Right">
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </MultiBinding>
                </FrameworkElement.Margin>
                <Button Name="PART_CloseButton" FrameworkElement.Style="{TemplateBinding local:WindowControl.CloseButtonStyle}" UIElement.Visibility="{TemplateBinding local:WindowControl.CloseButtonVisibility}" />
              </StackPanel>
              <Border Name="ToolWindowBorder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" FrameworkElement.VerticalAlignment="Top" UIElement.Visibility="Collapsed" FrameworkElement.HorizontalAlignment="Right">
                <FrameworkElement.Margin>
                  <MultiBinding ConverterParameter="2">
                    <MultiBinding.Converter>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowContentBorderMarginConverter</Ctor>
                      </StaticResourceExtension>
                    </MultiBinding.Converter>
                    <Binding Path="WindowThickness.Right">
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                    <Binding Path="WindowThickness.Right">
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </MultiBinding>
                </FrameworkElement.Margin>
                <Button Name="PART_ToolWindowCloseButton" FrameworkElement.Margin="0,3,0,1" FrameworkElement.Style="{TemplateBinding local:WindowControl.CloseButtonStyle}" />
              </Border>
              <Thumb Name="PART_HeaderThumb" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" UIElement.Opacity="0" Control.IsTabStop="False" />
            </Grid>
            <Border Name="ContentOuterBorder" Grid.Row="1" BorderBrush="#FFDFEEFD" BorderThickness="1">
              <FrameworkElement.Margin>
                <MultiBinding ConverterParameter="0">
                  <MultiBinding.Converter>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowContentBorderMarginConverter</Ctor>
                    </StaticResourceExtension>
                  </MultiBinding.Converter>
                  <Binding Path="WindowThickness.Left">
                    <Binding.RelativeSource>
                      <RelativeSource>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                      </RelativeSource>
                    </Binding.RelativeSource>
                  </Binding>
                  <Binding Path="WindowThickness.Bottom">
                    <Binding.RelativeSource>
                      <RelativeSource>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                      </RelativeSource>
                    </Binding.RelativeSource>
                  </Binding>
                </MultiBinding>
              </FrameworkElement.Margin>
              <Border Name="ContentBorder" Background="{TemplateBinding Control.Background}" BorderBrush="#5D6C7A" BorderThickness="1">
                <Border Name="ContentInnerBorder" BorderBrush="#FFF2F2F2" BorderThickness="0">
                  <ContentPresenter Name="Content" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
                </Border>
              </Border>
            </Border>
          </Grid>
        </Border>
      </Border>
      <Border Name="PART_BlockMouseInputsBorder" Background="#00FFFFFF" UIElement.Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="local:WindowControl.WindowStyle" Value="None">
        <Setter TargetName="HeaderRow" Property="RowDefinition.Height" Value="0" />
        <Setter TargetName="PART_Icon" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="Title" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="PART_HeaderThumb" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="ButtonsPanel" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="HeaderRow" Property="RowDefinition.Height" Value="0" />
      </Trigger>
      <Trigger Property="local:WindowControl.WindowStyle" Value="ToolWindow">
        <Setter TargetName="HeaderRow" Property="RowDefinition.Height" Value="Auto" />
        <Setter TargetName="PART_Icon" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="ButtonsPanel" Property="UIElement.Visibility" Value="Collapsed" />
        <Setter TargetName="ToolWindowBorder" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="PART_WindowRoot" Property="Border.CornerRadius" Value="0" />
        <Setter TargetName="WindowRootInnerBorder" Property="Border.CornerRadius" Value="0" />
        <Setter TargetName="ContentOuterBorder" Property="Border.BorderBrush" Value="#FFFFFFFF" />
        <Setter TargetName="ContentBorder" Property="Border.BorderBrush" Value="#FF000000" />
        <Setter TargetName="ContentInnerBorder" Property="Border.BorderThickness" Value="1" />
      </Trigger>
      <Trigger Property="local:WindowControl.IsActive" Value="False">
        <Setter TargetName="PART_WindowRoot" Property="Border.Background">
          <Setter.Value>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowInactiveBackground</Ctor>
              <Binding.RelativeSource>
                <RelativeSource>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                </RelativeSource>
              </Binding.RelativeSource>
            </Binding>
          </Setter.Value>
        </Setter>
        <Setter TargetName="PART_WindowRoot" Property="Border.BorderBrush" Value="#FF666666" />
        <Setter TargetName="ContentBorder" Property="Border.BorderBrush" Value="#FF7B7B7B" />
        <Setter TargetName="Content" Property="UIElement.IsEnabled" Value="False" />
      </Trigger>
      <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
      </Trigger>
      <Trigger SourceName="TitleText" Property="TextBlock.Text" Value="">
        <Setter TargetName="TitleText" Property="FrameworkElement.Margin" Value="0" />
      </Trigger>
      <Trigger SourceName="TitleText" Property="TextBlock.Text">
        <Trigger.Value>
          <NullExtension />
        </Trigger.Value>
        <Setter TargetName="TitleText" Property="FrameworkElement.Margin" Value="0" />
      </Trigger>
      <DataTrigger Value="1">
        <DataTrigger.Binding>
          <MultiBinding>
            <MultiBinding.Converter>
              <StaticResourceExtension xmlns="">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CenterTitleConverter</Ctor>
              </StaticResourceExtension>
            </MultiBinding.Converter>
            <Binding ElementName="TitleText" Path="DesiredSize" />
            <Binding ElementName="PART_HeaderGrid" Path="ActualWidth" />
            <Binding ElementName="PART_HeaderGrid" Path="ColumnDefinitions" />
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter TargetName="Title" Property="Grid.Column" Value="0" />
        <Setter TargetName="Title" Property="Grid.ColumnSpan" Value="4" />
        <Setter TargetName="TitleGrid" Property="FrameworkElement.HorizontalAlignment" Value="Center" />
      </DataTrigger>
      <DataTrigger Value="2">
        <DataTrigger.Binding>
          <MultiBinding>
            <MultiBinding.Converter>
              <StaticResourceExtension xmlns="">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CenterTitleConverter</Ctor>
              </StaticResourceExtension>
            </MultiBinding.Converter>
            <Binding ElementName="TitleText" Path="DesiredSize" />
            <Binding ElementName="PART_HeaderGrid" Path="ActualWidth" />
            <Binding ElementName="PART_HeaderGrid" Path="ColumnDefinitions" />
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter TargetName="TitleGrid" Property="FrameworkElement.HorizontalAlignment" Value="Center" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WindowControl</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="local:WindowControl.CloseButtonStyle">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">
            <ComponentResourceKey ResourceId="DefaultCloseButtonStyle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <ComponentResourceKey.TypeInTargetAssembly>
                <x:TypeExtension>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WindowControl</Ctor>
                </x:TypeExtension>
              </ComponentResourceKey.TypeInTargetAssembly>
            </ComponentResourceKey>
          </Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Background">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_Background</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="local:WindowControl.CaptionForeground">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_CaptionForeground</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="local:WindowControl.WindowBorderBrush">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_WindowBorderBrush</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="local:WindowControl.WindowBackground">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_WindowBackground</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="local:WindowControl.WindowBorderThickness">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_WindowBorderThickness</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="local:WindowControl.WindowInactiveBackground">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Window_WindowInactiveBackground</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.IsTabStop" Value="False" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">WindowControlTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:WindowControl</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>