<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters" xmlns:colconv="clr-namespace:Xceed.Wpf.Toolkit.Converters" xmlns:themes="clr-namespace:Xceed.Wpf.Toolkit.Themes" xmlns:pg="clr-namespace:Xceed.Wpf.Toolkit.PropertyGrid">
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <conv:ObjectTypeToNameConverter x:Key="ObjectTypeToNameConverter" />
  <colconv:NewItemTypesComboBoxConverter x:Key="NewItemTypesComboBoxConverter" />
  <Style x:Key="CollectionControlButtonStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.Triggers>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="0.6" />
      </Trigger>
    </Style.Triggers>
    <Setter Property="Control.HorizontalContentAlignment" Value="Center" />
    <Setter Property="Control.VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.Height" Value="26" />
    <Setter Property="FrameworkElement.Width" Value="26" />
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:CollectionControl</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.Resources>
      <ResourceDictionary>
        <Style>
          <Style.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListBox</Ctor>
            </x:TypeExtension>
          </Style.TargetType>
          <Setter Property="ItemsControl.ItemTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock>
                  <TextBlock.Text>
                    <Binding>
                      <Binding.Converter>
                        <StaticResourceExtension xmlns="">
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ObjectTypeToNameConverter</Ctor>
                        </StaticResourceExtension>
                      </Binding.Converter>
                    </Binding>
                  </TextBlock.Text>
                </TextBlock>
              </DataTemplate>
            </Setter.Value>
          </Setter>
          <x:Key>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListBox</Ctor>
            </x:TypeExtension>
          </x:Key>
        </Style>
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:CollectionControl</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.5*" />
              </Grid.ColumnDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock FrameworkElement.Margin="0,0,0,5" Text="Select type:" />
                <ComboBox Name="PART_NewItemTypesComboBox" Grid.Row="1" FrameworkElement.Margin="0,0,0,3" FrameworkElement.HorizontalAlignment="Stretch" ItemsControl.DisplayMemberPath="Name">
                  <ItemsControl.ItemsSource>
                    <MultiBinding>
                      <MultiBinding.Converter>
                        <StaticResourceExtension xmlns="">
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">NewItemTypesComboBoxConverter</Ctor>
                        </StaticResourceExtension>
                      </MultiBinding.Converter>
                      <Binding Path="ItemsSourceType">
                        <Binding.RelativeSource>
                          <RelativeSource>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                          </RelativeSource>
                        </Binding.RelativeSource>
                      </Binding>
                      <Binding Path="NewItemTypes">
                        <Binding.RelativeSource>
                          <RelativeSource>
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                          </RelativeSource>
                        </Binding.RelativeSource>
                      </Binding>
                    </MultiBinding>
                  </ItemsControl.ItemsSource>
                </ComboBox>
                <Button FrameworkElement.Margin="3,0,0,3" Grid.Row="1" Grid.Column="1" Control.Padding="5,0" ContentControl.Content="Add" ButtonBase.Command="New">
                  <ButtonBase.CommandParameter>
                    <Binding ElementName="PART_NewItemTypesComboBox">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedItem</Ctor>
                    </Binding>
                  </ButtonBase.CommandParameter>
                </Button>
                <ListBox Name="_itemsListBox" Grid.Row="2" Grid.ColumnSpan="2" Selector.SelectedIndex="0">
                  <ItemsControl.ItemsSource>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Items</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </ItemsControl.ItemsSource>
                  <Selector.SelectedItem>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedItem</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </Selector.SelectedItem>
                </ListBox>
                <StackPanel FrameworkElement.Margin="7,2,0,0" FrameworkElement.VerticalAlignment="Top" Grid.Column="2" Grid.Row="2">
                  <Button ButtonBase.Command="ComponentCommands.MoveUp">
                    <FrameworkElement.Style>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CollectionControlButtonStyle</Ctor>
                      </StaticResourceExtension>
                    </FrameworkElement.Style>
                    <ButtonBase.CommandParameter>
                      <Binding ElementName="_itemsListBox">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedItem</Ctor>
                      </Binding>
                    </ButtonBase.CommandParameter>
                    <Path Shape.Fill="#FF000000" Data="M6,0 L12,7 L8,7 L8,12 L4,12 L4,7 L0,7" />
                  </Button>
                  <Button FrameworkElement.Margin="0,1,0,0" ButtonBase.Command="ComponentCommands.MoveDown">
                    <FrameworkElement.Style>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CollectionControlButtonStyle</Ctor>
                      </StaticResourceExtension>
                    </FrameworkElement.Style>
                    <ButtonBase.CommandParameter>
                      <Binding ElementName="_itemsListBox">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedItem</Ctor>
                      </Binding>
                    </ButtonBase.CommandParameter>
                    <Path Shape.Fill="#FF000000" Data="M4,0 L8,0 L8,5 L12,5 L6,12 L0,5 L4,5" />
                  </Button>
                  <Button FrameworkElement.Margin="0,7,0,0" ButtonBase.Command="Delete">
                    <FrameworkElement.Style>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CollectionControlButtonStyle</Ctor>
                      </StaticResourceExtension>
                    </FrameworkElement.Style>
                    <ButtonBase.CommandParameter>
                      <Binding ElementName="_itemsListBox">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedItem</Ctor>
                      </Binding>
                    </ButtonBase.CommandParameter>
                    <Image Stretch="None" FrameworkElement.Height="16" FrameworkElement.Width="16" FrameworkElement.Margin="1" Source="./../Images/Delete16.png" />
                  </Button>
                </StackPanel>
              </Grid>
              <Grid Column="1" FrameworkElement.Margin="20,0,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Text="Properties:" />
                <pg:PropertyGrid Grid.Row="1" Grid.Column="1" FrameworkElement.Margin="0,5,0,0" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch">
                  <pg:PropertyGrid.SelectedObject>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedItem</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </pg:PropertyGrid.SelectedObject>
                  <pg:PropertyGrid.IsReadOnly>
                    <Binding>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsReadOnly</Ctor>
                      <Binding.RelativeSource>
                        <RelativeSource>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                        </RelativeSource>
                      </Binding.RelativeSource>
                    </Binding>
                  </pg:PropertyGrid.IsReadOnly>
                </pg:PropertyGrid>
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:CollectionControl</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:PrimitiveTypeCollectionControl</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}" />
    <Setter Property="Control.Background" Value="#00FFFFFF" />
    <Setter Property="Control.BorderThickness" Value="1,1,0,1" />
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="Control.Padding" Value="2,0,0,0" />
    <Setter Property="Control.VerticalContentAlignment" Value="Center" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:PrimitiveTypeCollectionControl</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <local:MultiLineTextEditor Control.Background="{TemplateBinding Control.Background}" Control.BorderBrush="{TemplateBinding Control.BorderBrush}" Control.BorderThickness="{TemplateBinding Control.BorderThickness}" ContentControl.Content="{TemplateBinding ContentControl.Content}" Control.Padding="{TemplateBinding Control.Padding}" Control.HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" IsOpen="{TemplateBinding local:PrimitiveTypeCollectionControl.IsOpen}" IsReadOnly="{TemplateBinding local:PrimitiveTypeCollectionControl.IsReadOnly}" Control.VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}">
            <local:MultiLineTextEditor.Text>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Text</Ctor>
                <Binding.RelativeSource>
                  <RelativeSource>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                  </RelativeSource>
                </Binding.RelativeSource>
              </Binding>
            </local:MultiLineTextEditor.Text>
          </local:MultiLineTextEditor>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlMouseOverBorderKey}}" Property="Control.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlSelectedBorderKey}}" Property="Control.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {Static themes:ResourceKeys.ControlDisabledBackgroundKey}}" Property="Control.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:PrimitiveTypeCollectionControl</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>