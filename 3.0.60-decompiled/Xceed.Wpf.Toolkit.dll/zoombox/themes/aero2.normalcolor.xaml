  <Style x:Key="TransparentButton">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ButtonBase</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.BasedOn>
      <NullExtension />
    </Style.BasedOn>
    <Setter Property="FrameworkElement.FocusVisualStyle">
      <Setter.Value>
        <NullExtension />
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Background" Value="#333333" />
    <Setter Property="Control.Foreground" Value="#cccccc" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ButtonBase</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid Panel.Background="#00FFFFFF" FrameworkElement.Cursor="Hand">
            <Rectangle Name="BackgroundTextBoxRectangle" Shape.Fill="{TemplateBinding Control.Background}" Shape.Stroke="{TemplateBinding Control.Foreground}" RadiusX="3" RadiusY="3" UIElement.Opacity="0" />
            <ContentPresenter />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="BackgroundTextBoxRectangle" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="BackgroundTextBoxRectangle" Property="UIElement.Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ViewFinderToggleButtonStyle">
    <Style.BasedOn>
      <StaticResourceExtension xmlns="">
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TransparentButton</Ctor>
      </StaticResourceExtension>
    </Style.BasedOn>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="UIElement.Visibility" Value="Visible" />
    <Style.Triggers>
      <DataTrigger Value="Hidden">
        <DataTrigger.Binding>
          <Binding Path="ViewFinderVisibility">
            <Binding.RelativeSource>
              <RelativeSource>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">FindAncestor</Ctor>
                <RelativeSource.AncestorType>
                  <x:TypeExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:Zoombox</Ctor>
                  </x:TypeExtension>
                </RelativeSource.AncestorType>
              </RelativeSource>
            </Binding.RelativeSource>
          </Binding>
        </DataTrigger.Binding>
        <Setter Property="UIElement.Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
