<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Xceed.Wpf.Toolkit" xmlns:conv="clr-namespace:Xceed.Wpf.Toolkit.Core.Converters" xmlns:themes="clr-namespace:Xceed.Wpf.Toolkit.Themes" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:chrome="clr-namespace:Xceed.Wpf.Toolkit.Chromes">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../../Themes/Aero2/Common.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <conv:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter" />
  <Style x:Key="ColorItemContainerStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListBoxItem</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="FrameworkElement.ToolTip">
      <Setter.Value>
        <Binding>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Name</Ctor>
        </Binding>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListBoxItem</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid>
            <FrameworkElement.ToolTip>
              <Binding>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Name</Ctor>
              </Binding>
            </FrameworkElement.ToolTip>
            <ContentPresenter FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" />
            <Border Name="_outerBorder" BorderThickness="1" Background="#00FFFFFF" BorderBrush="#00FFFFFF" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch">
              <Border Name="_innerBorder" Background="#00FFFFFF" BorderThickness="1" BorderBrush="#00FFFFFF" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="_outerBorder" Value="{DynamicResource {Static themes:ResourceKeys.ControlSelectedBorderKey}}" Property="Border.BorderBrush" />
              <Setter TargetName="_innerBorder" Value="{DynamicResource {Static themes:ResourceKeys.ButtonMouseOverBackgroundKey}}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="_outerBorder" Value="{DynamicResource {Static themes:ResourceKeys.ControlSelectedBorderKey}}" Property="Border.BorderBrush" />
              <Setter TargetName="_innerBorder" Value="{DynamicResource {Static themes:ResourceKeys.ButtonMouseOverBackgroundKey}}" Property="Border.BorderBrush" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="ColorItemTemplate">
    <Grid>
      <Border BorderBrush="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}" BorderThickness="1" FrameworkElement.Margin="2,2,2,2">
        <Border.Background>
          <StaticResourceExtension xmlns="">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CheckerBrush</Ctor>
          </StaticResourceExtension>
        </Border.Background>
        <Rectangle FrameworkElement.Width="14" FrameworkElement.Height="14">
          <FrameworkElement.Style>
            <Style>
              <Style.TargetType>
                <x:TypeExtension>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Rectangle</Ctor>
                </x:TypeExtension>
              </Style.TargetType>
              <Setter Property="Shape.Fill">
                <Setter.Value>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Color</Ctor>
                    <Binding.Converter>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorToSolidColorBrushConverter</Ctor>
                      </StaticResourceExtension>
                    </Binding.Converter>
                  </Binding>
                </Setter.Value>
              </Setter>
            </Style>
          </FrameworkElement.Style>
        </Rectangle>
      </Border>
    </Grid>
  </DataTemplate>
  <Style x:Key="ColorPickerToggleButtonStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ToggleButton</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid UIElement.SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" UIElement.SnapsToDevicePixels="True">
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" FrameworkElement.VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" FrameworkElement.HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" />
              </Border>
              <chrome:ButtonChrome Name="ToggleButtonChrome" Grid.Column="1" CornerRadius="0" RenderMouseOver="{TemplateBinding UIElement.IsMouseOver}" RenderPressed="{TemplateBinding ButtonBase.IsPressed}">
                <UIElement.Visibility>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowDropDownButton</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource Mode="FindAncestor" AncestorType="local:ColorPicker" />
                    </Binding.RelativeSource>
                    <Binding.Converter>
                      <StaticResourceExtension xmlns="">
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BooleanToVisibilityConverter</Ctor>
                      </StaticResourceExtension>
                    </Binding.Converter>
                  </Binding>
                </UIElement.Visibility>
                <chrome:ButtonChrome.RenderChecked>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource Mode="FindAncestor" AncestorType="local:ColorPicker" />
                    </Binding.RelativeSource>
                  </Binding>
                </chrome:ButtonChrome.RenderChecked>
                <chrome:ButtonChrome.RenderEnabled>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsEnabled</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource Mode="FindAncestor" AncestorType="local:ColorPicker" />
                    </Binding.RelativeSource>
                  </Binding>
                </chrome:ButtonChrome.RenderEnabled>
                <Grid Name="arrowGlyph" UIElement.IsHitTestVisible="False" Column="1" FrameworkElement.Margin="5">
                  <Path Name="Arrow" FrameworkElement.Width="7" FrameworkElement.Height="4" Data="M0,1 C0,1 0,0 0,0 C0,0 3,0 3,0 C3,0 3,1 3,1 C3,1 4,1 4,1 C4,1 4,0 4,0 C4,0 7,0 7,0 C7,0 7,1 7,1 C7,1 6,1 6,1 C6,1 6,2 6,2 C6,2 5,2 5,2 C5,2 5,3 5,3 C5,3 4,3 4,3 C4,3 4,4 4,4 C4,4 3,4 3,4 C3,4 3,3 3,3 C3,3 2,3 2,3 C2,3 2,2 2,2 C2,2 1,2 1,2 C1,2 1,1 1,1 C1,1 0,1 0,1" Shape.Fill="{DynamicResource {Static SystemColors.ControlTextBrushKey}}" />
                </Grid>
              </chrome:ButtonChrome>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter TargetName="Arrow" Value="{DynamicResource {Static SystemColors.GrayTextBrushKey}}" Property="Shape.Fill" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ColorDisplayStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ContentControl</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="ContentControl.ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Border>
            <Border.Background>
              <StaticResourceExtension xmlns="">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CheckerBrush</Ctor>
              </StaticResourceExtension>
            </Border.Background>
            <Rectangle>
              <Shape.Fill>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedColor</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource Mode="FindAncestor" AncestorType="local:ColorPicker" />
                  </Binding.RelativeSource>
                  <Binding.Converter>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorToSolidColorBrushConverter</Ctor>
                    </StaticResourceExtension>
                  </Binding.Converter>
                </Binding>
              </Shape.Fill>
            </Rectangle>
          </Border>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ColorListStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ListBox</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="#00FFFFFF" />
    <Setter Property="Control.BorderThickness" Value="0" />
    <Setter Property="ItemsControl.ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel FrameworkElement.Width="200" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsControl.ItemContainerStyle">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorItemContainerStyle</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsControl.ItemTemplate">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorItemTemplate</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="ListBox.SelectionMode" Value="Single" />
  </Style>
  <Style x:Key="ColorPicker">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ColorPicker</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter Property="Control.Background" Value="#FFFFFFFF" />
    <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}" />
    <Setter Property="Control.BorderThickness" Value="1,1,0,1" />
    <Setter Property="local:ColorPicker.ButtonStyle">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorPickerToggleButtonStyle</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Control.VerticalContentAlignment" Value="Center" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ColorPicker</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Grid>
            <ToggleButton Name="PART_ColorPickerToggleButton" Control.IsTabStop="True" FrameworkElement.MinHeight="22" Control.Background="{TemplateBinding Control.Background}" Control.BorderBrush="{TemplateBinding Control.BorderBrush}" Control.BorderThickness="{TemplateBinding Control.BorderThickness}" Control.VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" Control.HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Control.Padding="{TemplateBinding Control.Padding}" FrameworkElement.Style="{TemplateBinding local:ColorPicker.ButtonStyle}">
              <ToggleButton.IsChecked>
                <Binding Mode="TwoWay">
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                </Binding>
              </ToggleButton.IsChecked>
              <UIElement.IsHitTestVisible>
                <Binding>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsOpen</Ctor>
                  <Binding.RelativeSource>
                    <RelativeSource>
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                    </RelativeSource>
                  </Binding.RelativeSource>
                  <Binding.Converter>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">InverseBoolConverter</Ctor>
                    </StaticResourceExtension>
                  </Binding.Converter>
                </Binding>
              </UIElement.IsHitTestVisible>
              <Grid FrameworkElement.Margin="2">
                <ContentControl Name="ColorOnly">
                  <FrameworkElement.Style>
                    <StaticResourceExtension xmlns="">
                      <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorDisplayStyle</Ctor>
                    </StaticResourceExtension>
                  </FrameworkElement.Style>
                </ContentControl>
                <Border Name="ColorAndName" Background="#FFFFFFFF" UIElement.Visibility="Hidden">
                  <StackPanel Orientation="Horizontal">
                    <ContentControl FrameworkElement.HorizontalAlignment="Left" FrameworkElement.Width="20" FrameworkElement.Margin="2,1,4,1" Control.BorderThickness="1" Control.BorderBrush="{DynamicResource {Static themes:ResourceKeys.ControlNormalBorderKey}}">
                      <FrameworkElement.Style>
                        <StaticResourceExtension xmlns="">
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorDisplayStyle</Ctor>
                        </StaticResourceExtension>
                      </FrameworkElement.Style>
                    </ContentControl>
                    <TextBlock FrameworkElement.VerticalAlignment="Center">
                      <TextBlock.Text>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedColorText</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </Grid>
            </ToggleButton>
            <Popup Name="PART_ColorPickerPalettePopup" FrameworkElement.VerticalAlignment="Bottom" StaysOpen="False" AllowsTransparency="True" UIElement.Focusable="False" HorizontalOffset="1" VerticalOffset="1" PopupAnimation="Slide">
              <Popup.IsOpen>
                <Binding ElementName="PART_ColorPickerToggleButton" Path="IsChecked" />
              </Popup.IsOpen>
              <Border BorderThickness="1" Padding="3">
                <Border.Background>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">PanelBackgroundBrush</Ctor>
                  </StaticResourceExtension>
                </Border.Background>
                <Border.BorderBrush>
                  <StaticResourceExtension xmlns="">
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">PopupDarkBorderBrush</Ctor>
                  </StaticResourceExtension>
                </Border.BorderBrush>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Name="_colorPaletteHost" UIElement.Visibility="Collapsed" FrameworkElement.Margin="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Row="1">
                      <UIElement.Visibility>
                        <TemplateBindingExtension>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowAvailableColors</Ctor>
                          <TemplateBindingExtension.Converter>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BooleanToVisibilityConverter</Ctor>
                            </StaticResourceExtension>
                          </TemplateBindingExtension.Converter>
                        </TemplateBindingExtension>
                      </UIElement.Visibility>
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{TemplateBinding local:ColorPicker.AvailableColorsHeader}" Background="#FFF0F8FF" Padding="2" FrameworkElement.Margin="0,0,0,1" />
                        <ListBox Name="PART_AvailableColors" Grid.Row="1">
                          <FrameworkElement.Style>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorListStyle</Ctor>
                            </StaticResourceExtension>
                          </FrameworkElement.Style>
                          <ItemsControl.ItemsSource>
                            <Binding>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">AvailableColors</Ctor>
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </ItemsControl.ItemsSource>
                        </ListBox>
                      </Grid>
                    </Grid>
                    <Grid Row="2">
                      <UIElement.Visibility>
                        <TemplateBindingExtension>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowStandardColors</Ctor>
                          <TemplateBindingExtension.Converter>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BooleanToVisibilityConverter</Ctor>
                            </StaticResourceExtension>
                          </TemplateBindingExtension.Converter>
                        </TemplateBindingExtension>
                      </UIElement.Visibility>
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{TemplateBinding local:ColorPicker.StandardColorsHeader}" Background="#FFF0F8FF" Padding="2" FrameworkElement.Margin="0,1,0,1" />
                        <ListBox Name="PART_StandardColors" Grid.Row="1">
                          <FrameworkElement.Style>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorListStyle</Ctor>
                            </StaticResourceExtension>
                          </FrameworkElement.Style>
                          <ItemsControl.ItemsSource>
                            <Binding>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">StandardColors</Ctor>
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </ItemsControl.ItemsSource>
                        </ListBox>
                      </Grid>
                    </Grid>
                    <Grid Row="3" FrameworkElement.Margin="0,1,0,1">
                      <UIElement.Visibility>
                        <TemplateBindingExtension>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowRecentColors</Ctor>
                          <TemplateBindingExtension.Converter>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BooleanToVisibilityConverter</Ctor>
                            </StaticResourceExtension>
                          </TemplateBindingExtension.Converter>
                        </TemplateBindingExtension>
                      </UIElement.Visibility>
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{TemplateBinding local:ColorPicker.RecentColorsHeader}" Background="#FFF0F8FF" Padding="2" FrameworkElement.Margin="0,1,0,1" />
                        <ListBox Name="PART_RecentColors" Grid.Row="1">
                          <FrameworkElement.Style>
                            <StaticResourceExtension xmlns="">
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorListStyle</Ctor>
                            </StaticResourceExtension>
                          </FrameworkElement.Style>
                          <ItemsControl.ItemsSource>
                            <Binding>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">RecentColors</Ctor>
                              <Binding.RelativeSource>
                                <RelativeSource>
                                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                                </RelativeSource>
                              </Binding.RelativeSource>
                            </Binding>
                          </ItemsControl.ItemsSource>
                        </ListBox>
                      </Grid>
                    </Grid>
                  </Grid>
                  <Grid Name="_colorCanvasHost" UIElement.Visibility="Collapsed">
                    <local:ColorCanvas Control.Background="#00FFFFFF" Control.BorderThickness="0">
                      <local:ColorCanvas.UsingAlphaChannel>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">UsingAlphaChannel</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </local:ColorCanvas.UsingAlphaChannel>
                      <local:ColorCanvas.SelectedColor>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">SelectedColor</Ctor>
                          <Binding.RelativeSource>
                            <RelativeSource>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TemplatedParent</Ctor>
                            </RelativeSource>
                          </Binding.RelativeSource>
                        </Binding>
                      </local:ColorCanvas.SelectedColor>
                    </local:ColorCanvas>
                  </Grid>
                  <Separator Grid.Row="1" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.Margin="5,0,5,0" />
                  <Button Name="PART_ColorModeButton" Grid.Row="2" FrameworkElement.Margin="5">
                    <UIElement.Visibility>
                      <TemplateBindingExtension>
                        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ShowAdvancedButton</Ctor>
                        <TemplateBindingExtension.Converter>
                          <StaticResourceExtension xmlns="">
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">BooleanToVisibilityConverter</Ctor>
                          </StaticResourceExtension>
                        </TemplateBindingExtension.Converter>
                      </TemplateBindingExtension>
                    </UIElement.Visibility>
                  </Button>
                </Grid>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="local:ColorPicker.DisplayColorAndName" Value="True">
              <Setter TargetName="ColorOnly" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="ColorAndName" Property="UIElement.Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="local:ColorPicker.ColorMode" Value="ColorPalette">
              <Setter TargetName="_colorPaletteHost" Property="UIElement.Visibility" Value="Visible" />
              <Setter TargetName="_colorCanvasHost" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="PART_ColorModeButton" Property="ContentControl.Content" Value="Advanced" />
            </Trigger>
            <Trigger Property="local:ColorPicker.ColorMode" Value="ColorCanvas">
              <Setter TargetName="_colorPaletteHost" Property="UIElement.Visibility" Value="Collapsed" />
              <Setter TargetName="_colorCanvasHost" Property="UIElement.Visibility" Value="Visible" />
              <Setter TargetName="PART_ColorModeButton" Property="ContentControl.Content" Value="Standard" />
            </Trigger>
            <Trigger Property="local:ColorPicker.ShowDropDownButton" Value="False">
              <Setter Property="Control.BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlMouseOverBorderKey}}" />
      </Trigger>
      <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
        <Setter Property="Control.BorderBrush" Value="{DynamicResource {Static themes:ResourceKeys.ControlSelectedBorderKey}}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style>
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ColorPicker</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Style.BasedOn>
      <StaticResourceExtension xmlns="">
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ColorPicker</Ctor>
      </StaticResourceExtension>
    </Style.BasedOn>
    <x:Key>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">local:ColorPicker</Ctor>
      </x:TypeExtension>
    </x:Key>
  </Style>
</ResourceDictionary>