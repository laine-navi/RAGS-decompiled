<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Rags</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Rags" />
    <EmbeddedResource Include="Rags" LogicalName="Rags" />
    <ApplicationConfig Remove="Rags.exe.config" />
    <ApplicationConfig Include="Rags.exe.config" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RagsLib">
      <HintPath>2.4.16-slightly-faster/RagsLib.dll</HintPath>
    </Reference>
    <Reference Include="System.Web.Services" />
    <Reference Include="AxInterop.WMPLib" />
    <Reference Include="System.Xml">
      <HintPath>../../../../../../../../../../../../usr/lib64/dotnet/shared/Microsoft.NETCore.App/10.0.12/System.Xml.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SqlServerCe" />
    <Reference Include="Microsoft.JScript" />
    <Reference Include="Interop.WMPLib" />
    <Reference Include="System.Data">
      <HintPath>../../../../../../../../../../../../usr/lib64/dotnet/shared/Microsoft.NETCore.App/10.0.12/System.Data.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>